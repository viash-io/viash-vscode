{
  "name": "viash",
  "displayName": "Viash",
  "description": "The official Viash VS Code extension.",
  "author": "Data Intuitive",
  "publisher": "data-intuitive",
  "icon": "assets/logo/viash.png",
  "license": "GPL-3.0-only",
  "keywords": [
    "viash",
    "workflows",
    "nextflow",
    "testing"
  ],
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/viash-io/viash-vscode.git"
  },
  "homepage": "https://github.com/viash-io/viash-vscode",
  "bugs": {
    "url": "https://github.com/viash-io/viash-vscode/issues"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Linters",
    "Other"
  ],
  "engines": {
    "vscode": "^1.107.0"
  },
  "activationEvents": [
    "workspaceContains:**/*.vsh.{yaml,yml,py,R,r,sh,js,scala,cs}",
    "workspaceContains:**/_viash.{yaml,yml}"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "viash.vlint.fixAll",
        "title": "Fix all safe problems",
        "category": "Viash Lint"
      },
      {
        "command": "viash.vlint.fixAllUnsafe",
        "title": "Fix all problems, also unsafe",
        "category": "Viash Lint"
      },
      {
        "command": "viash.vlint.restart",
        "title": "Restart the language server",
        "category": "Viash Lint"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "viash.vlint.fixAll",
          "when": "editorLangId == yaml"
        },
        {
          "command": "viash.vlint.fixAllUnsafe",
          "when": "editorLangId == yaml"
        }
      ]
    },
    "configuration": {
      "title": "Viash",
      "properties": {
        "viash.vlint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Start the Viash Lint language server (`vlint server`) for YAML files."
        },
        "viash.vlint.path": {
          "type": "string",
          "default": "",
          "description": "The path to the `vlint` binary. If empty, `vlint` on the `PATH` is used."
        },
        "viash.vlint.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Show the LSP messages in the output panel \"Viash Lint\"."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha -r ts-node/register 'src/**/*.test.ts'",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/chai": "^5.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "~25.0.3",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "^3.7.1",
    "chai": "^5.1.2",
    "mocha": "^11.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "dependencies": {
    "vscode-languageclient": "^11.0.0",
    "vscode-test-adapter-api": "^1.9.0",
    "vscode-test-adapter-util": "^0.7.1",
    "yaml": "^2.5.0"
  }
}
